<%= turbo_stream.append "list-of-comments" do %>
  <%= @comment.user.user_name%>
  <%=  @comment.content %>
<% end %>

<%= turbo_stream.update "new_comment_frame" do %>
  <%= turbo_frame_tag "new_comment_frame" do %>
    <%= link_to "Add a comment", new_post_comment_path(@post), data: { turbo_frame: "new_comment_frame" } %>
  <% end %>
<% end %>
