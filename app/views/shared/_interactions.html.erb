<div class="post-interactions" data-controller = "posts-interactions"
            data-posts_interactions-id-value="<%= post.id%>"> 

              
    <div>
        <button type="button" data-posts-interactions-target="btn1"
            data-action="click->posts-interactions#update"
            data-url="<%=  add_like_post_like_path(post)%>" 
            <%='disabled' if current_user.liked_posts.include?(post)%>>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <title>Like</title>
                    <path d="M5,9V21H1V9H5M9,21A2,2 0 0,1 7,19V9C7,8.45 7.22,7.95 7.59,7.59L14.17,1L15.23,2.06C15.5,2.33 15.67,2.7 15.67,3.11L15.64,3.43L14.69,8H21C22.11,8 23,8.9 23,10V12C23,12.26 22.95,12.5 22.86,12.73L19.84,19.78C19.54,20.5 18.83,21 18,21H9M9,19H18.03L21,12V10H12.21L13.34,4.68L9,9.03V19Z" />          
                </svg>
        </button>
        <%=post.number_of_likes%>
                    
    </div>
                   
    <div>
        <button type="button" data-posts-interactions-target="btn2"
            data-action="click->posts-interactions#update" 
            data-url="<%=remove_like_post_like_path(post)%>"
            <%='disabled' unless current_user.liked_posts.include?(post)%>>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <title>dislike</title>
                    <path d="M19,15H23V3H19M15,3H6C5.17,3 4.46,3.5 4.16,4.22L1.14,11.27C1.05,11.5 1,11.74 1,12V14A2,2 0 0,0 3,16H9.31L8.36,20.57C8.34,20.67 8.33,20.77 8.33,20.88C8.33,21.3 8.5,21.67 8.77,21.94L9.83,23L16.41,16.41C16.78,16.05 17,15.55 17,15V5C17,3.89 16.1,3 15,3Z" />
                </svg>
        </button>
        <%=post.num_of_dislikes%>
    </div>
                    
    
    <%if current_user.id == post.author_id%>
        <div>
            <%= button_to post, method: :delete, data: { turbo_confirm: "Are you sure?"} do%>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <title>delete</title>
                    <path d="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M9,8H11V17H9V8M13,8H15V17H13V8Z" />
                </svg>
                <%end%>
        </div>
    <%end%>
</div>