<div class="posts-container">
    <div class="post-content">
        <% posts.each do |post|%>
            <div class="post-card">
                <div class="post-info">
                    <h4> <%=link_to post.title, post%> </h4>
                    <h5>By: <%=link_to post.author_user_name, user_path(post.author_id)%> </h5>
                </div>
                <div class="post-body">
                    <%= post.body%>
                    <p>add post date and interactions</p>
                </div>

                <%=render partial: "shared/interactions", locals: {post: post}%>
                
                <div class="post-interactions">
                    <div>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <title>Comment</title>
                                <path d="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22V22H9M10,16V19.08L13.08,16H20V4H4V16H10M17,11H15V9H17V11M13,11H11V9H13V11M9,11H7V9H9V11Z" />
                            </svg>
                            <%=post.number_of_comments%>
                        </div>
                </div>
            </div>
        <%end%>
    </div>
</div>


