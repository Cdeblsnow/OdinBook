<div class="posts-container">
    <div class="post-content">
        <% posts.each do |post|%>
            <div class="post-card">
                <div class="post-info">
                    <h4> <%=link_to post.title, post%> </h4>
                    <h5>By: <%=link_to post.author_user_name, user_path(post.author_id)%> </h5>
                </div>
                <div class="post-body">
                    <%= post.body%>
                    <p>add post date and interactions</p>
                </div>
                <div class="post-interactions">
                    <p> like and comment btn not working yet</p>
                    <% if current_user.likes.last&.num_likes == 1%>
                        <div>
                            <%= button_to remove_like_like_path(post) do%>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                        <title>dislike</title>
                                        <path d="M19,15H23V3H19M15,3H6C5.17,3 4.46,3.5 4.16,4.22L1.14,11.27C1.05,11.5 1,11.74 1,12V14A2,2 0 0,0 3,16H9.31L8.36,20.57C8.34,20.67 8.33,20.77 8.33,20.88C8.33,21.3 8.5,21.67 8.77,21.94L9.83,23L16.41,16.41C16.78,16.05 17,15.55 17,15V5C17,3.89 16.1,3 15,3Z" />
                                </svg>
                            <%end%>
                            <%=post.number_dislikes%>
                        </div>
                    <%else%>
                        <div>
                            <%= button_to add_like_like_path(post) do%>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                    <title>Like</title>
                                    <path d="M5,9V21H1V9H5M9,21A2,2 0 0,1 7,19V9C7,8.45 7.22,7.95 7.59,7.59L14.17,1L15.23,2.06C15.5,2.33 15.67,2.7 15.67,3.11L15.64,3.43L14.69,8H21C22.11,8 23,8.9 23,10V12C23,12.26 22.95,12.5 22.86,12.73L19.84,19.78C19.54,20.5 18.83,21 18,21H9M9,19H18.03L21,12V10H12.21L13.34,4.68L9,9.03V19Z" />
                                    
                                </svg>
                            <%end%>
                            <%=post.number_likes%>
                        </div>
                    <%end%>
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <title>Comment</title>
                        <path d="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22V22H9M10,16V19.08L13.08,16H20V4H4V16H10M17,11H15V9H17V11M13,11H11V9H13V11M9,11H7V9H9V11Z" />
                        </svg>
                        <%=post.number_of_comments%>
                    </div>
                </div>
            </div>
            <%if current_user.id == post.author_id%>
                <%= button_to "Delete post", post, method: :delete,
                            data: { turbo_confirm: "Are you sure?"}%>
            <%end%>
        <%end%>
    </div>
</div>

