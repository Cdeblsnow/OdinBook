<div class="user-profile-card">
    <div class="user-name">
        <h2>
            <%= @user.user_name%>
        </h2>
        <li>
            <%# update css. remove li  %>
            <%= link_to edit_user_registration_path do%>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <title>Edit profile</title>
                <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" />
            </svg>
            <%end%>
        </li>
        <% if current_user.id == @user.id%>
            <p> My profile</p>
        <%elsif  current_user.following.include?(@user.id)%>
            <%= button_to "Unfollow", unfollow_user_path(@user), method: :post, class: "btn-follow"%>
        <%elsif @user.follow_request_list.include?(current_user.id)%>
            <%= button_to "Cancel request"%>
        <%else%>
            <%= button_to "Follow", follow_request_user_path(@user), method: :post, class: "btn-follow"%>
        <%end%>
    </div>
    <div class="user-follow">
        <div>
            <p> add space and check behavior when follow butn is on display</p>
            <p>Followers</p>
            <p><%=@user.followed_by.count%></p>
        </div>
        <div>
            <p>Following</p>
            <p><%=@user.following.count%></p>
        </div>
    </div>
</div>

<div>
    <h3> Activity (place holder)</h3>
    <%if @user.posts.count == 0%>
        <p>This is sadly empty</p>
    <%else%>
        <%=render partial: "shared/posts", locals: {posts: @user.posts}%>
    <%end%>
</div>