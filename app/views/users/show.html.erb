<div class="user-profile-card">
    <div class="user-name">
        <h2>
            <%= @user.user_name%>
        </h2>
        <% if current_user.id == @user.id%>
            <p> My profile</p>
        <%elsif  current_user.following.include?(@user.id)%>
            <%= button_to "Unfollow", unfollow_user_path(@user), method: :post, class: "btn-follow"%>
        <%else%>
            <%= button_to "Follow", follow_user_path(@user), method: :post, class: "btn-follow"%>
        <%end%>
    </div>
    <div class="user-follow">
        <div>
            <p> add space and check behavior when follow butn is on display</p>
            <p>Followers</p>
            <p><%=@user.following.count%></p>
        </div>
        <div>
            <p>Following</p>
            <p><%=@user.followed_by.count%></p>
        </div>
    </div>
</div>

<div class="posts-container">
        <h3> Activity</h3>
        <div class="post-content">
            <%if @user.posts.count == 0%>
                <p>This is sadly empty</p>
            <%else%>
                <% @user.posts.each do |post|%>
                <div class="post-card">
                     <h4><%= post.title%> </h4>
                    <div class="post-body">
                        <%= post.body%>
                        <p>add post date and interactions</p>
                    </div>
                    <div class="post-interactions">
                        <div>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <title>Like</title>
                                <path d="M5,9V21H1V9H5M9,21A2,2 0 0,1 7,19V9C7,8.45 7.22,7.95 7.59,7.59L14.17,1L15.23,2.06C15.5,2.33 15.67,2.7 15.67,3.11L15.64,3.43L14.69,8H21C22.11,8 23,8.9 23,10V12C23,12.26 22.95,12.5 22.86,12.73L19.84,19.78C19.54,20.5 18.83,21 18,21H9M9,19H18.03L21,12V10H12.21L13.34,4.68L9,9.03V19Z" />
                            </svg>
                            <%=post.number_of_likes%>
                        </div>
                        <div>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <title>Comment</title>
                                <path d="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22V22H9M10,16V19.08L13.08,16H20V4H4V16H10M17,11H15V9H17V11M13,11H11V9H13V11M9,11H7V9H9V11Z" />
                            </svg>
                            <%=post.number_of_comments%>
                        </div>
                    </div>
                </div>
                 <%end%>
            <%end%>
        </div>
</div>