<div class="follow-list">
    <h1>Find people</h1>
    
    <%@user.each do |user|%>
        <%if user != current_user%>
            <div class="follow-field">
                <p>You are not following <%=user.user_name%> </p>
                <%if user.follow_request_list.include?(current_user.id)%>
                    <%= button_to "Cancel request", cancel_follow_request_user_path(user), method: :post%>
                <%else%>
                    <%= button_to "Follow", follow_request_user_path(user), method: :post, class: "btn-follow"%>
                <%end%>
            </div>
        <%end%>
            
    <%end%>
</div>