<h2><%@post.title%> </h2>
<div>
    <%= @post.body%>
</div>

<div id = "comment-section">
    <%= turbo_frame_tag "new_comment_frame" do%>
        <%= link_to "Add a comment", new_post_comment_path(@post), data: { turbo_frame:"new_comment_frame"}%>
    <%end%>

    <div id= "list-of-comments">
        <%  @post.comments.each do |c|%>
            <%= c.content%>
        <%end%>
    </div>
</div>

