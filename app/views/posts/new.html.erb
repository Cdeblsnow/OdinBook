<div class="new-post">
    <h2>New post</h2>
    
    <%=form_with model:@post do |f|%>
        <div class="field">
            <p><%=f.label :title, "Enter a title"%></p>
            <p><%=f.text_field :title%></p>
        </div>

        <div class="field">
            <p><%=f.label :body, "What is this about?"%></p>
            <p><%=f.text_field :body%></p>
        </div>

        <div class="actions">
            <%= f.submit "Post"%>
        </div>
    <%end%>
</div>